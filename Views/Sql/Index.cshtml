@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>SQL Server</title>
    <meta name="app-base" content="@Url.Content("~/")" />
    <link rel="stylesheet" href="~/lib/lucide/lucide.css" />
    <link rel="stylesheet" href="~/lib/codemirror/codemirror.css" />
    <link rel="stylesheet" href="~/lib/codemirror/addon/show-hint.css" />
    <link rel="stylesheet" href="~/lib/codemirror/addon/dialog.css" />
    <link rel="stylesheet" href="~/css/browser.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sql.css" asp-append-version="true" />
</head>
<body>
<div id="sqlTop">
    <span class="grow"></span>
    <img src="~/img/sqlserver.jpg" alt="SQL Server" class="sqlLogo" />
    <span id="connInfo" class="connInfo"></span>
    <span id="connState" class="connState"></span>
    <select id="connSel" title="Saved databases"></select>
    <button id="bConnAdd" title="Add a database"><i class="icon-plus" style="color:#1e9e5a"></i> Add database</button>
    <button id="bConnUpd" title="Replace the saved connection string"><i class="icon-refresh-cw" style="color:#3a7bd5"></i> Update</button>
    <button id="bConnDel" title="Remove this saved database"><i class="icon-trash-2" style="color:#d9363e"></i> Forget</button>
    <button id="bRun" title="F5"><i class="icon-play" style="color:#1e9e5a"></i> Run <span class="key">F5</span></button>
    <button id="bCancel" disabled><i class="icon-square" style="color:#d9363e"></i> Cancel</button>
    <span class="sep"></span>
    <button id="bXlsx" disabled><i class="icon-file-spreadsheet" style="color:#1e7e45"></i> Excel</button>
    <button id="bCsv" disabled><i class="icon-file-text" style="color:#666"></i> CSV</button>
    <span class="sep"></span>
    <button id="bProfiler" title="Open the SQL profiler in a new tab"><i class="icon-activity" style="color:#8e44ad"></i> Profiler</button>
</div>
<div id="sqlTabs"></div>

<div id="sqlMain">
    <!-- SQL Editor tab -->
    <div id="paneEditor" class="pane">
        <div class="hints">
            <span><b>F5</b> run (selection if any)</span><span><b>Ctrl+3</b> top 500</span><span><b>Ctrl+4</b> top 1</span>
            <span><b>Ctrl+5</b> column info</span><span><b>Alt+F1</b> table details</span><span><b>Ctrl+F1</b> SP/view/function text</span>
            <span><b>Ctrl+R</b> toggle results</span><span><b>Ctrl+/</b> toggle comment</span><span><b>Ctrl+K, C / U</b> comment / uncomment (Ctrl may stay held)</span><span><b>Ctrl+Space</b> complete</span><span><b>Ctrl+F</b> find</span><span><b>Ctrl+H</b> replace</span>
            <span><b>GO</b> on its own line splits batches</span>
        </div>
        <div id="sessionBar"></div>
        <div id="edWrap"><div id="edBox"></div></div>
        <div id="splitter" title="Drag to resize"></div>
        <div id="results">
            <div id="resTabs"></div>
            <div id="resBody"><div class="muted pad">Run a query to see results.</div></div>
        </div>
    </div>

    <!-- Explorer tabs (tables, views, ...) share one layout -->
    <div id="paneExplorer" class="pane" hidden>
        <div class="listPane">
            <div class="listHead" id="listHead"></div>
            <div class="listSearch"><input id="listFilter" type="text" placeholder="Search..." spellcheck="false" /><button id="bListRefresh" title="Refresh list"><i class="icon-refresh-cw" style="color:#1e9e5a"></i></button></div>
            <div id="listItems"></div>
        </div>
        <div id="detail"><div class="muted pad">Select an item.</div></div>
    </div>
</div>

<div id="status"><span id="stLeft"></span><span id="busy" hidden></span><span id="stRight"></span></div>
<div id="ctx" hidden></div>

<div id="connPanel" hidden>
    <div class="box">
        <h3 id="cpTitle">Add database</h3>
        <p class="muted">Paste the SQL Server connection string. It is encrypted in this browser before it is sent, stored encrypted on the server and cannot be shown again. This browser keeps only a key for it.</p>
        <label>Name <input id="cpLabel" type="text" maxlength="60" placeholder="e.g. Production ERP" autocomplete="off" spellcheck="false" /></label>
        <label>Connection string
            <textarea id="cpString" rows="4" placeholder="Server=...;Database=...;User Id=...;Password=...;TrustServerCertificate=True;" autocomplete="off" spellcheck="false"></textarea>
        </label>
        <div id="cpMsg" class="bad"></div>
        <div class="btns"><button id="cpSave">Save and connect</button><button id="cpCancel">Cancel</button></div>
        <div class="muted small" id="cpFp"></div>
    </div>
</div>

<script src="~/lib/codemirror/codemirror.js"></script>
<script src="~/lib/codemirror/mode/sql.js"></script>
@foreach (var a in new[] { "searchcursor", "search", "dialog", "jump-to-line", "matchbrackets", "closebrackets", "active-line", "comment", "show-hint", "sql-hint" })
{
    <script src="~/lib/codemirror/addon/@(a).js"></script>
}
<script src="~/js/sql.js" asp-append-version="true"></script>
</body>
</html>
